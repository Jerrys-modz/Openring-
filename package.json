{
  "name": "openring",
  "version": "0.1.0",
  "private": true,
  "description": "RingConn BLE protocol core (TypeScript) for an Expo / React Native HealthKit sync app",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "start": "expo start --dev-client",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "lint": "eslint .",
    "validate": "npm run lint && npm run typecheck && npm test -- --ci",
    "build:testflight": "eas build --platform ios --profile testflight --non-interactive --no-wait",
    "submit:testflight": "eas submit --platform ios --profile testflight --latest --non-interactive"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "expo": "~57.0.27",
    "expo-dev-client": "^57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-status-bar": "^57.0.1",
    "jest-expo": "~57.0.5",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-nitro-modules": "^0.37.1"
  },
  "main": "index.ts",
  "jest": {
    "preset": "jest-expo"
  }
}

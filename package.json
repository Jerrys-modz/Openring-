{
  "name": "openring",
  "version": "0.1.0",
  "private": true,
  "description": "RingConn BLE protocol core (TypeScript) for an Expo / React Native HealthKit sync app",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "start": "expo start --dev-client",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "expo-dev-client": "^57.0.19",
    "expo-status-bar": "^57.0.1",
    "jest-expo": "~57.0.5",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-ble-plx": "^3.5.1"
  },
  "main": "index.ts",
  "jest": {
    "preset": "jest-expo"
  }
}
